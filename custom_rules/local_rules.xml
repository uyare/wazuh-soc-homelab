<!-- Local rules -->

<!-- 
  [WINDOWS SECURITY] Guest Account Activation
  Triggers when Event ID 4722 is detected for the 'Guest' account.
  Compliance / ATT&CK: MITRE T1078 (Valid Accounts)
-->
<group name="windows, windows_security, account_changed, adduser,">

  <rule id="100200" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4722$</field>
    <field name="win.eventdata.targetUserName">^Guest$</field>

    <description>SOC-Lab Windows10 Guest account was enabled.</description>

    <mitre>
      <id>T1078</id>
    </mitre>

    <group>windows_account_management, account_enabled, guest_account</group>
  </rule>

</group>
